{
  "name": "eventsphere-server",
  "version": "1.0.0",
  "type": "module",
  "description": "EventSphere backend authentication and event management API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "seed:admin": "node src/scripts/seedAdmin.js",
    "seed:demo": "node src/scripts/seedDemoUsers.js",
    "seed:milestone1": "node src/scripts/seedMilestone1Data.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testTimeout=30000 --runInBand --detectOpenHandles --forceExit"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  }
}
