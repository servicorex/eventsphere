# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Connection Settings
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_postgres_password
PGDATABASE=eventsphere_db

# Session Security Configuration
# Generate a strong random key (e.g., using `openssl rand -hex 32`)
SESSION_SECRET=your-strong-random-session-secret-key-min-32-chars
SESSION_MAX_AGE_MS=86400000

# Client Configuration / CORS Origin
CLIENT_URL=http://localhost:5173

# Initial Admin Account Setup (used by scripts/seedAdmin.js)
ADMIN_NAME=EventSphere Admin
ADMIN_EMAIL=admin@eventsphere.com
ADMIN_PASSWORD=AdminSecurePassword123!
